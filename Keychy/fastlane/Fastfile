default_platform(:ios)

platform :ios do

  # App Store Connect API Key 설정 (로컬/CI 양쪽 지원)
  before_all do
    if ENV["CI"]
      app_store_connect_api_key(
        key_id: ENV["ASC_KEY_ID"],
        issuer_id: ENV["ASC_ISSUER_ID"],
        key_content: ENV["ASC_KEY_CONTENT"]
      )
    else
      app_store_connect_api_key(
        key_id: "7X4FZ564SR",
        issuer_id: "c5d0448a-84ed-476a-a74a-d4cc0cc84bd3",
        key_filepath: "fastlane/AuthKey_7X4FZ564SR.p8"
      )
    end

    # CI에서는 프로젝트 서명 설정을 Distribution으로 변경
    if ENV["CI"]
      update_code_signing_settings(
        use_automatic_signing: false,
        path: "Keychy.xcodeproj",
        team_id: "BUKGH5MWAT",
        profile_name: "KeychyApp Distribution",
        code_sign_identity: "Apple Distribution",
        targets: ["Keychy"],
        build_configurations: ["Release"]
      )
      update_code_signing_settings(
        use_automatic_signing: false,
        path: "Keychy.xcodeproj",
        team_id: "BUKGH5MWAT",
        profile_name: "KeychyApp Widget Distribution",
        code_sign_identity: "Apple Distribution",
        targets: ["WidgetKeychyExtension"],
        build_configurations: ["Release"]
      )
    end
  end

  # TestFlight 업로드
  desc "TestFlight에 빌드 업로드"
  lane :testflight do
    build_num = Time.now.strftime("%y%m%d%H%M")
    increment_build_number(
      build_number: build_num,
      xcodeproj: "Keychy.xcodeproj"
    )
    increment_build_number(
      build_number: build_num,
      xcodeproj: "Keychy.xcodeproj",
      target: "WidgetKeychyExtension"
    )
    build_app(
      scheme: "Keychy",
      export_method: "app-store",
      clean: true,
      export_options: {
        signingStyle: "manual",
        signingCertificate: "Apple Distribution",
        provisioningProfiles: {
          "com.KeychyOfficial.app" => "KeychyApp Distribution",
          "com.KeychyOfficial.app.WidgetKeychy" => "KeychyApp Widget Distribution"
        }
      }
    )
    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )
  end

  # App Store 업로드
  desc "App Store에 빌드 업로드"
  lane :appstore do
    build_num = Time.now.strftime("%y%m%d%H%M")
    increment_build_number(
      build_number: build_num,
      xcodeproj: "Keychy.xcodeproj"
    )
    increment_build_number(
      build_number: build_num,
      xcodeproj: "Keychy.xcodeproj",
      target: "WidgetKeychyExtension"
    )
    build_app(
      scheme: "Keychy",
      export_method: "app-store",
      clean: true,
      export_options: {
        signingStyle: "manual",
        signingCertificate: "Apple Distribution",
        provisioningProfiles: {
          "com.KeychyOfficial.app" => "KeychyApp Distribution",
          "com.KeychyOfficial.app.WidgetKeychy" => "KeychyApp Widget Distribution"
        }
      }
    )
    upload_to_app_store(
      skip_metadata: true,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false
    )
  end

end
